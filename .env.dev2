# ===============================================================================
# AiSOC Developer 2 - Environment Configuration
# ===============================================================================

# Distinct project prefix for Docker Compose isolation
COMPOSE_PROJECT_NAME=aisoc-dev2

# ─── Image Pinning ────────────────────────────────────────────────────────────
AISOC_VERSION=latest

# ─── Core Configuration ───────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=dev2_secret_key_change_in_production_at_least_32_chars
AISOC_REALTIME_JWT_SECRET=dev2_realtime_jwt_secret_token_hex
AISOC_REALTIME_TICKET_TTL_SECONDS=60

# Application-layer encryption key for connector credentials
AISOC_CREDENTIAL_KEY=p2EbZTU7RWwDpq5_xwoNl8UBsAV6mrlScJ7bIoE3DSY=
AISOC_CREDENTIAL_KEY_ROTATION_FROM=

# Internal URL the API uses to reach the connectors microservice
CONNECTORS_SERVICE_URL=http://connectors:8003
CONNECTORS_SERVICE_TIMEOUT_SECONDS=15

# ─── Port bindings for Developer 2 (2xxxx range) ──────────────────────────────
HOST_POSTGRES_PORT=25432
HOST_REDIS_PORT=26379
HOST_KAFKA_PORT=29092
HOST_KAFKA_UI_PORT=28090
HOST_CLICKHOUSE_PORT=28123
HOST_CLICKHOUSE_NATIVE_PORT=29000
HOST_OPENSEARCH_PORT=29200
HOST_QDRANT_PORT=26333
HOST_NEO4J_HTTP_PORT=27474
HOST_NEO4J_BOLT_PORT=27687

HOST_API_PORT=28000
HOST_INGEST_PORT=28081
HOST_INGEST_METRICS_PORT=29090
HOST_ENRICHMENT_PORT=28080
HOST_FUSION_PORT=28003
HOST_AGENTS_PORT=28001
HOST_OSQUERY_TLS_PORT=28091
HOST_ACTIONS_PORT=28002
HOST_CONNECTORS_PORT=28088
HOST_THREATINTEL_PORT=28005
HOST_UEBA_PORT=28007
HOST_HONEYTOKENS_PORT=28008
HOST_PURPLE_TEAM_PORT=28006
HOST_REALTIME_PORT=28086
HOST_SLACK_BOT_PORT=28009
HOST_WEB_PORT=23000

HOST_PROMETHEUS_PORT=29091
HOST_ALERTMANAGER_PORT=29094
HOST_GRAFANA_PORT=23001

# ─── Database & External services (mapped to Developer 2 Host Ports) ──────────
POSTGRES_PASSWORD=aisoc_dev2_secret
DATABASE_URL=postgresql+asyncpg://aisoc:aisoc_dev2_secret@localhost:25432/aisoc
REDIS_URL=redis://:redis_dev_secret@localhost:26379/0
CLICKHOUSE_URL=http://aisoc:clickhouse_dev_secret@localhost:28123/aisoc

# ─── Messaging ────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ─── Search ───────────────────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:29200
QDRANT_URL=http://localhost:26333

# ─── Threat Intelligence ──────────────────────────────────────────────────────
TAXII_FEEDS=https://cti-taxii.mitre.org/taxii/,enterprise-attack,,
MISP_URL=
MISP_API_KEY=
OTX_API_KEY=
CISA_KEV_ENABLED=true
ABUSE_CH_ENABLED=true

# Free / freemium enrichment
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
SHODAN_API_KEY=
URLSCAN_API_KEY=
IPINFO_API_TOKEN=

# ─── Commercial threat intelligence (optional) ────────────────────────────────
CYBLE_VISION_API_KEY=
CYBLE_VISION_BASE_URL=https://api.cyble.com/v2
CYBLE_VISION_TENANT_ID=
CYBLE_VISION_FEEDS=indicators,actors,vulnerabilities,leaks,brand
CYBLE_HUNT_API_KEY=

RECORDED_FUTURE_API_KEY=
MANDIANT_API_KEY=
MANDIANT_API_SECRET=
CROWDSTRIKE_INTEL_CLIENT_ID=
CROWDSTRIKE_INTEL_CLIENT_SECRET=
ANOMALI_USERNAME=
ANOMALI_API_KEY=
ANOMALI_BASE_URL=https://api.threatstream.com
XFORCE_API_KEY=
XFORCE_API_PASSWORD=
FLASHPOINT_API_KEY=
INTEL471_USERNAME=
INTEL471_API_KEY=
DOMAINTOOLS_USERNAME=
DOMAINTOOLS_API_KEY=
RISKIQ_USERNAME=
RISKIQ_API_KEY=

# ─── Connectors ───────────────────────────────────────────────────────────────
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com

# Splunk
SPLUNK_HOST=
SPLUNK_PORT=8089
SPLUNK_TOKEN=
SPLUNK_SCHEME=https
SPLUNK_VERIFY_SSL=true

# AWS Security Hub
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Okta
OKTA_DOMAIN=
OKTA_API_TOKEN=

# Microsoft Sentinel
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_WORKSPACE_NAME=

# ─── Frontend (pointed to Developer 2 Host Ports) ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:28000
NEXT_PUBLIC_REALTIME_URL=http://localhost:28086
NEXT_PUBLIC_WS_URL=ws://localhost:28086
NEXT_PUBLIC_DEMO_MODE=false

# ─── AI / LLM Local Configuration ─────────────────────────────────────────────
AISOC_AIRGAPPED=true
AISOC_AIRGAP_ALLOWLIST=qwen.proxy.ainexus.ktcloud.com,threatfox.abuse.ch,urlhaus.abuse.ch,www.cisa.gov

OPENAI_API_KEY=sk-local-vllm
OPENAI_BASE_URL=https://qwen.proxy.ainexus.ktcloud.com/v1
OPENAI_API_BASE=https://qwen.proxy.ainexus.ktcloud.com/v1
OPENAI_MODEL_NAME=/models/Qwen3-1.7B
OPENAI_MODEL=/models/Qwen3-1.7B
LLM_PROVIDER=openai

LLM_BASE_URL=https://qwen.proxy.ainexus.ktcloud.com/v1
LLM_API_KEY=vllm-no-key-needed
LLM_MODEL=/models/Qwen3-1.7B
