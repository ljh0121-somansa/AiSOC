# ===============================================================================
# AiSOC Developer 1 - Environment Configuration
# ===============================================================================

# Distinct project prefix for Docker Compose isolation
COMPOSE_PROJECT_NAME=aisoc-dev1

# ─── Image Pinning ────────────────────────────────────────────────────────────
AISOC_VERSION=latest

# ─── Core Configuration ───────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=dev1_secret_key_change_in_production_at_least_32_chars
AISOC_REALTIME_JWT_SECRET=dev1_realtime_jwt_secret_token_hex
AISOC_REALTIME_TICKET_TTL_SECONDS=60

# Application-layer encryption key for connector credentials
AISOC_CREDENTIAL_KEY=p2EbZTU7RWwDpq5_xwoNl8UBsAV6mrlScJ7bIoE3DSY=
AISOC_CREDENTIAL_KEY_ROTATION_FROM=

# Internal URL the API uses to reach the connectors microservice
CONNECTORS_SERVICE_URL=http://connectors:8003
CONNECTORS_SERVICE_TIMEOUT_SECONDS=15

# ─── Port bindings for Developer 1 (1xxxx range) ──────────────────────────────
HOST_POSTGRES_PORT=15432
HOST_REDIS_PORT=16379
HOST_KAFKA_PORT=19092
HOST_KAFKA_UI_PORT=18090
HOST_CLICKHOUSE_PORT=18123
HOST_CLICKHOUSE_NATIVE_PORT=19000
HOST_OPENSEARCH_PORT=19200
HOST_QDRANT_PORT=16333
HOST_NEO4J_HTTP_PORT=17474
HOST_NEO4J_BOLT_PORT=17687

HOST_API_PORT=18000
HOST_INGEST_PORT=18081
HOST_INGEST_METRICS_PORT=19090
HOST_ENRICHMENT_PORT=18080
HOST_FUSION_PORT=18003
HOST_AGENTS_PORT=18001
HOST_OSQUERY_TLS_PORT=18091
HOST_ACTIONS_PORT=18002
HOST_CONNECTORS_PORT=18088
HOST_THREATINTEL_PORT=18005
HOST_UEBA_PORT=18007
HOST_HONEYTOKENS_PORT=18008
HOST_PURPLE_TEAM_PORT=18006
HOST_REALTIME_PORT=18086
HOST_SLACK_BOT_PORT=18009
HOST_WEB_PORT=13000

HOST_PROMETHEUS_PORT=19091
HOST_ALERTMANAGER_PORT=19094
HOST_GRAFANA_PORT=13001

# ─── Database & External services (mapped to Developer 1 Host Ports) ──────────
POSTGRES_PASSWORD=aisoc_dev1_secret
DATABASE_URL=postgresql+asyncpg://aisoc:aisoc_dev1_secret@localhost:15432/aisoc
REDIS_URL=redis://:redis_dev_secret@localhost:16379/0
CLICKHOUSE_URL=http://aisoc:clickhouse_dev_secret@localhost:18123/aisoc

# ─── Messaging ────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ─── Search ───────────────────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:19200
QDRANT_URL=http://localhost:16333

# ─── Threat Intelligence ──────────────────────────────────────────────────────
TAXII_FEEDS=https://cti-taxii.mitre.org/taxii/,enterprise-attack,,
MISP_URL=
MISP_API_KEY=
OTX_API_KEY=
CISA_KEV_ENABLED=true
ABUSE_CH_ENABLED=true

# Free / freemium enrichment
